{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://audiflow.app/schema/v1/pattern-index.json",
  "title": "Pattern Index",
  "description": "Root meta.json listing all pattern configs with their summaries.",
  "type": "object",
  "required": [
    "dataVersion",
    "schemaVersion",
    "patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "dataVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Data format version."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema definition version. Bumped when fields are added or changed."
    },
    "patterns": {
      "type": "array",
      "description": "Summary entries for each pattern config.",
      "items": {
        "$ref": "#/$defs/PatternSummary"
      }
    }
  },
  "$defs": {
    "PatternSummary": {
      "type": "object",
      "description": "Summary of a pattern config for discovery and listing.",
      "required": [
        "id",
        "dataVersion",
        "displayName",
        "feedUrlHint",
        "playlistCount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this pattern config."
        },
        "dataVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Data format version of this pattern."
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable name for display."
        },
        "feedUrlHint": {
          "type": "string",
          "description": "Representative feed URL for display."
        },
        "playlistCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of playlist definitions in this pattern."
        }
      }
    }
  }
}
